CREATE TABLE Countries (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    official_name TEXT NOT NULL,
    capital TEXT NOT NULL,
    region TEXT NOT NULL,
    subregion TEXT NOT NULL,
    population INTEGER NOT NULL,
    flag_png_url TEXT NOT NULL,
    currency_name TEXT NOT NULL,
    currency_symbol TEXT NOT NULL
);

upsertCountry:
INSERT OR REPLACE INTO Countries(
    id,
    name,
    official_name,
    capital,
    region,
    subregion,
    population,
    flag_png_url,
    currency_name,
    currency_symbol
)
VALUES(
    :id,
    :name,
    :officialName,
    :capital,
    :region,
    :subregion,
    :population,
    :flagPngUrl,
    :currencyName,
    :currencySymbol
);

getCountriesList:
SELECT * FROM Countries;

getCountryById:
SELECT * FROM Countries
WHERE id = ?;

getCountryDetailsById:
SELECT
    c.id,
    c.name,
    c.official_name,
    c.capital,
    c.region,
    c.subregion,
    c.population,
    c.flag_png_url,
    c.currency_name,
    c.currency_symbol,
    CASE
        WHEN f.country_id IS NOT NULL THEN 1
        ELSE 0
    END AS isFavorite
FROM Countries c
LEFT JOIN Favorites f
    ON c.id = f.country_id
WHERE c.id = ?;
