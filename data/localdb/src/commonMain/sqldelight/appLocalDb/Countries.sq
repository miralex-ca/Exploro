CREATE TABLE Countries (
    id TEXT NOT NULL PRIMARY KEY,
    iso2 TEXT NOT NULL,
    name TEXT NOT NULL,
    official_name TEXT NOT NULL,
    capital TEXT NOT NULL,
    continent TEXT NOT NULL,
    location TEXT NOT NULL,
    flag_image TEXT NOT NULL,
    flag_emoji TEXT NOT NULL
);

CREATE INDEX idx_countries_continent
ON Countries(continent);

upsertCountry:
INSERT OR REPLACE INTO Countries(
    id,
    iso2,
    name,
    official_name,
    capital,
    continent,
    location,
    flag_image,
    flag_emoji
)
VALUES(
    :id,
    :iso2,
    :name,
    :officialName,
    :capital,
    :continent,
    :location,
    :flagImage,
    :flagEmoji
);

getCountryDetailsById:
SELECT
    c.id,
    c.iso2,
    c.name,
    c.official_name,
    c.capital,
    c.continent,
    c.location,
    c.flag_image,
    c.flag_emoji,

    d.population,
    d.total_area,
    d.coat_of_arms_url,
    d.currency_code,
    d.currency_name,
    d.currency_symbol,
    d.languages,
    d.maps_url,
    d.timezones,
    d.wiki_url,
    d.latitude,
    d.longitude,

    CASE
        WHEN f.country_id IS NOT NULL THEN 1
        ELSE 0
    END AS isFavorite

FROM Countries c
LEFT JOIN CountryDetails d ON d.country_id = c.id
LEFT JOIN Favorites f ON f.country_id = c.id
WHERE c.id = ?;


getCountriesByContinent:
SELECT *
FROM Countries
WHERE continent = :continent
ORDER BY RANDOM()
LIMIT :limit;

getAllCountriesByContinent:
SELECT *
FROM Countries
WHERE continent = :continent
ORDER BY name ASC;

searchCountries:
SELECT *
FROM Countries
WHERE LOWER(name) LIKE LOWER('%' || ? || '%')
   OR LOWER(official_name) LIKE LOWER('%' || ? || '%')
   OR LOWER(capital) LIKE LOWER('%' || ? || '%')
ORDER BY name;

countCountries:
SELECT COUNT(*) FROM Countries;


getAllCountriesWithDetails:
SELECT
    c.id,
    c.iso2,
    c.name,
    c.official_name,
    c.capital,
    c.continent,
    c.location,
    c.flag_image,
    c.flag_emoji,

    d.population,
    d.total_area,
    d.coat_of_arms_url,
    d.currency_code,
    d.currency_name,
    d.currency_symbol,
    d.languages,
    d.maps_url,
    d.timezones,
    d.wiki_url,
    d.latitude,
    d.longitude

FROM Countries c
LEFT JOIN CountryDetails d ON d.country_id = c.id
ORDER BY c.name ASC;
