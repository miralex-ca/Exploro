CREATE TABLE Countries (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    official_name TEXT NOT NULL,
    capital TEXT NOT NULL,
    continent TEXT NOT NULL,
    subregion TEXT NOT NULL,
    flag_png_url TEXT NOT NULL,
    flag_alt TEXT NOT NULL
);

CREATE INDEX idx_countries_continent
ON Countries(continent);

upsertCountry:
INSERT OR REPLACE INTO Countries(
    id,
    name,
    official_name,
    capital,
    continent,
    subregion,
    flag_png_url,
    flag_alt
)
VALUES(
    :id,
    :name,
    :officialName,
    :capital,
    :continent,
    :subregion,
    :flagPngUrl,
    :flagAlt
);

getCountriesList:
SELECT * FROM Countries;

getCountryById:
SELECT * FROM Countries
WHERE id = ?;

getCountryDetailsById:
SELECT
    c.id,
    c.name,
    c.official_name,
    c.capital,
    c.continent,
    c.subregion,
    c.flag_png_url,
    c.flag_alt,

    d.population,
    d.area,
    d.coat_of_arms_png_url,
    d.currency_code,
    d.currency_name,
    d.currency_symbol,
    d.languages,
    d.maps_google_url,
    d.maps_osm_url,
    d.timezones,

    CASE
        WHEN f.country_id IS NOT NULL THEN 1
        ELSE 0
    END AS isFavorite

FROM Countries c
LEFT JOIN CountryDetails d ON d.country_id = c.id
LEFT JOIN Favorites f ON f.country_id = c.id
WHERE c.id = ?;


getCountriesByContinent:
SELECT *
FROM Countries
WHERE continent = :continent
ORDER BY RANDOM()
LIMIT :limit;

getAllCountriesByContinent:
SELECT *
FROM Countries
WHERE continent = :continent
ORDER BY name ASC;
