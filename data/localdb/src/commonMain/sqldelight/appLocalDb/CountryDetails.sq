CREATE TABLE CountryDetails (
    country_id TEXT NOT NULL PRIMARY KEY,

    population INTEGER NOT NULL,
    total_area REAL NOT NULL,

    coat_of_arms_url TEXT NOT NULL,

    currency_code TEXT NOT NULL,
    currency_name TEXT NOT NULL,
    currency_symbol TEXT NOT NULL,

    languages TEXT NOT NULL,

    maps_url TEXT NOT NULL,

    timezones TEXT NOT NULL,
    wiki_url TEXT NOT NULL DEFAULT '',
    latitude REAL NOT NULL DEFAULT 0.0,
    longitude REAL NOT NULL DEFAULT 0.0,

    FOREIGN KEY (country_id) REFERENCES Countries(id)
);

upsertCountryDetails:
INSERT OR REPLACE INTO CountryDetails(
    country_id,
    population,
    total_area,
    coat_of_arms_url,
    currency_code,
    currency_name,
    currency_symbol,
    languages,
    maps_url,
    timezones,
    wiki_url,
    latitude,
    longitude
)
VALUES(
    :countryId,
    :population,
    :totalArea,
    :coatOfArmsUrl,
    :currencyCode,
    :currencyName,
    :currencySymbol,
    :languages,
    :mapsUrl,
    :timezones,
    :wikiUrl,
    :latitude,
    :longitude
);

getCountryDetailsById:
SELECT *
FROM CountryDetails
WHERE country_id = ?;

deleteCountryDetailsById:
DELETE FROM CountryDetails
WHERE country_id = ?;

clearCountryDetails:
DELETE FROM CountryDetails;
