CREATE TABLE Favorites (
    country_id TEXT NOT NULL PRIMARY KEY,
    added_at INTEGER NOT NULL,
    FOREIGN KEY (country_id) REFERENCES Countries(id)
);

isFavorite:
SELECT EXISTS(
    SELECT 1
    FROM Favorites
    WHERE country_id = ?
);

addFavorite:
INSERT OR IGNORE INTO Favorites(country_id, added_at)
VALUES (?, strftime('%s','now'));

removeFavorite:
DELETE FROM Favorites
WHERE country_id = ?;

getCountriesWithUserData:
SELECT
    c.id,
    c.name,
    c.official_name,
    c.capital,
    c.continent,
    c.subregion,
    c.flag_png_url,

    CASE
        WHEN f.country_id IS NOT NULL THEN 1
        ELSE 0
    END AS isFavorite
FROM Countries c
LEFT JOIN Favorites f
    ON c.id = f.country_id;

getFavoriteIds:
SELECT country_id
FROM Favorites;

getFavorites:
SELECT
    c.id,
    c.name,
    c.official_name,
    c.capital,
    c.continent,
    c.subregion,
    c.flag_png_url,
    c.flag_alt
FROM Countries c
INNER JOIN Favorites f
    ON c.id = f.country_id
ORDER BY f.added_at DESC;

