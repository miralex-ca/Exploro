CREATE TABLE Favorites (
    country_id TEXT NOT NULL PRIMARY KEY,
    FOREIGN KEY (country_id) REFERENCES Countries(id)
);

addFavorite:
INSERT OR IGNORE INTO Favorites(country_id) VALUES (?);

removeFavorite:
DELETE FROM Favorites WHERE country_id = ?;

getCountriesWithUserData:
SELECT c.id, c.name, c.official_name, c.capital, c.region, c.subregion, c.flag_png_url,
       CASE WHEN f.country_id IS NOT NULL THEN 1 ELSE 0 END AS isFavorite
FROM Countries c
LEFT JOIN Favorites f ON c.id = f.country_id;

getFavoriteIds:
SELECT country_id
FROM Favorites;

getFavorites:
SELECT c.id, c.name, c.official_name, c.capital, c.region, c.population, c.flag_png_url
FROM Countries c
INNER JOIN Favorites f ON c.id = f.country_id;