CREATE TABLE Favorites (
    country_id TEXT NOT NULL PRIMARY KEY,
    added_at INTEGER NOT NULL,
    FOREIGN KEY (country_id) REFERENCES Countries(id)
);

isFavorite:
SELECT EXISTS(
    SELECT 1
    FROM Favorites
    WHERE country_id = ?
);

addFavorite:
INSERT OR IGNORE INTO Favorites(country_id, added_at)
VALUES (?, strftime('%s','now'));

removeFavorite:
DELETE FROM Favorites
WHERE country_id = ?;

getFavorites:
SELECT
    c.id,
    c.iso2,
    c.name,
    c.official_name,
    c.capital,
    c.continent,
    c.location,
    c.flag_image,
    c.flag_emoji
FROM Countries c
INNER JOIN Favorites f
    ON c.id = f.country_id
ORDER BY f.added_at DESC;

getFavoritesWithTimestamp:
SELECT
    country_id,
    added_at
FROM Favorites;

addFavoriteWithTimestamp:
INSERT OR IGNORE INTO Favorites(
    country_id,
    added_at
)
VALUES (?, ?);
